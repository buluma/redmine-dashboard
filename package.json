{
  "name": "redmine-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "mem:dev": "MEMORY_LOGGING=true next dev -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "mem:start": "MEMORY_LOGGING=true next start -H 0.0.0.0",
    "postinstall": "prisma generate --schema=prisma/schema.dev.sqlite.prisma",
    "lint": "eslint",
    "audit": "bun audit --audit-level=high --ignore GHSA-vfj7-8cjw-p6xm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "mem:profile": "node --expose-gc -r ./scripts/memory-profiler.js next dev -H 0.0.0.0",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.dev.sqlite.prisma",
    "db:init": "sh scripts/db-init.sh",
    "sync:all": "node scripts/sync-all-issues.js",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:fill-missing": "node scripts/i18n-fill-missing.js",
    "mobile:dev": "npm run dev --prefix mobile/ionic",
    "mobile:build": "npm run build --prefix mobile/ionic"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "nanoid": ">=3.3.18",
    "deepmerge-ts": ">=8.0.0",
    "browserslist": "4.28.7",
    "js-yaml": "4.3.2",
    "mysql2": "^3.22.0",
    "zod": ">=4.6.6",
    "follow-redirects": ">=1.16.2"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.9.0",
    "@sentry/profiling-node": "11.9.0",
    "ajv": "^8.17.1",
    "@scalar/swagger-editor": "^1.0.2",
    "@serwist/next": "^9.5.7",
    "@slack/web-api": "^8.2.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@upstash/redis": "^1.37.0",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.10",
    "idb": "^8.0.4",
    "next": "16.4.1",
    "prisma": "^7.10.0",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-react": "^5.34.1",
    "vue": "^3.5.43",
    "web-push": "^3.6.7",
    "zod": "^4.6.6",
    "zustand": "^5.0.12"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@sentry/node-cpu-profiler",
    "better-sqlite3",
    "@tree-sitter-grammars/tree-sitter-yaml",
    "core-js-pure",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^28.1.0",
    "pg": "^8.23.1",
    "serwist": "^9.5.7",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
