{
  "name": "redmine-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "mem:dev": "MEMORY_LOGGING=true next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "mem:start": "MEMORY_LOGGING=true next start -H 0.0.0.0",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "mem:profile": "node --expose-gc -r ./scripts/memory-profiler.js next dev -H 0.0.0.0",
    "prisma:generate": "prisma generate",
    "db:init": "sh scripts/db-init.sh",
    "sync:all": "node scripts/sync-all-issues.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@scalar/swagger-editor": "^1.0.2",
    "@sentry/nextjs": "^10.40.0",
    "@sentry/profiling-node": "^10.40.0",
    "@serwist/next": "^9.5.7",
    "@slack/web-api": "^7.15.0",
    "@upstash/redis": "^1.37.0",
    "chart.js": "^4.5.1",
    "idb": "^8.0.3",
    "next": "16.2.3",
    "prisma": "^6.19.3",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.32.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "serwist": "^9.5.7",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
