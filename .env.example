DATABASE_URL="file:./dev.db"
DOCKER_DATABASE_URL="file:./prisma/dev.db"
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
SESSION_SECRET="replace-with-random-session-secret"
POLL_INTERVAL_MS="90000"
LEADER_LOCK_TTL_MS="90000"
SYNC_JOB_STALE_MS="600000"
ENABLE_SYNC_POLLER="false"
MOBILE_API_ENABLED="true"
MEMORY_LOGGING="false"
MEMORY_LOG_INTERVAL_MS="90000"
NODE_ENV="development"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_TRACES_SAMPLE_RATE="0.0"
SENTRY_PROFILE_SAMPLE_RATE="0.0"
SENTRY_ENABLE_LOGS="false"
SENTRY_ENABLE_CONSOLE_LOGGING="false"
SENTRY_SEND_DEFAULT_PII="false"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.0"
NEXT_PUBLIC_SENTRY_PROFILE_SAMPLE_RATE="0.0"
NEXT_PUBLIC_SENTRY_ENABLE_LOGS="false"
NEXT_PUBLIC_SENTRY_ENABLE_CONSOLE_LOGGING="false"
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII="false"
ENABLE_SENTRY_TEST_ROUTES="false"
NEXT_PUBLIC_ENABLE_SENTRY_TEST_ROUTES="false"
REDMINE_BASE_URL="https://redmine.example.com"
REDMINE_API_KEY="your-api-key"
REDMINE_ALLOWED_BASE_URLS="https://redmine.example.com,https://redbrick.example.space"
REDMINE_INSECURE_TLS_HOSTS=""
# Which issues to sync: "assigned" (only assigned/authored issues), "open" (all open), or "all" (every issue)
# Defaulting to "assigned" keeps manual sync jobs fast and reliable on large Redmine instances.
REDMINE_SYNC_ISSUE_SCOPE="assigned"

# =============================================================================
# Slack Configuration
# =============================================================================
# Bot User OAuth Token from Slack App (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Default channel/group ID to read messages from
SLACK_DEFAULT_CHANNEL_ID=C0123456789
# Auto-refresh interval in milliseconds (default: 30000 = 30 seconds)
SLACK_REFRESH_INTERVAL_MS=30000

# Slack Notifier Configuration (for Redmine → Slack notifications)
SLACK_NOTIFY_ENABLED=false
SLACK_NOTIFY_CHANNEL_ID=C0123456789
SLACK_NOTIFY_ON_CREATE=true
SLACK_NOTIFY_ON_UPDATE=true
SLACK_NOTIFY_ON_STATUS_CHANGE=true
SLACK_NOTIFY_ON_ASSIGNMENT=true
SLACK_NOTIFY_FORMAT=compact
