generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                  @id @default(cuid())
  emailOrUsername   String                  @unique
  displayName       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  credential        UserRedmineCredential?
  issues            Issue[]
  githubLinks       IssueGithubLink[]
  mobileApiTokens   MobileApiToken[]
  timeEntries       TimeEntry[]
  syncState         SyncState?
  syncJobs          SyncJob[]
  favorites         Favorite[]
  internalNotes     InternalNote[]
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId      Int      // Redmine issue ID
  createdAt    DateTime @default(now())

  @@unique([userId, issueId])
}

model RedmineUser {
  id           Int      @id
  name         String
  login        String?
  email        String?
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model RedmineEnumeration {
  id           Int      @id
  kind         String   // "issue_priority", "time_entry_activity", "document_category", "issue_category"
  name         String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  position     Int?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind, isActive])
  @@index([kind, position])
}

model UserRedmineCredential {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseUrl          String
  apiKeyEncrypted  String
  apiKeyIv         String
  isActive         Boolean  @default(true)
  lastValidatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Issue {
  id               String         @id @default(cuid())
  redmineIssueId   Int
  redmineBaseUrl   String
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          String
  description      String?
  projectName      String?
  tracker          String?
  priority         String?
  priorityId       Int?
  statusId         Int
  statusName       String
  parentIssueId    Int?
  parentIssueLabel String?
  assignedToId     Int?
  assignedToName   String?
  authorId         Int?
  authorName       String?
  categoryId       Int?
  categoryName     String?
  startDate        DateTime?
  estimatedHours   Float?
  spentHours       Float?
  customFieldsJson  Json?
  updatedOnRemote  DateTime
  dueDate          DateTime?
  doneRatio        Int?
  allowedStatusesJson Json?
  childrenJson     Json?
  journals         IssueJournal[]
  timeEntries      TimeEntry[]
  githubLinks      IssueGithubLink[]
  attachments      IssueAttachment[]
  relations        IssueRelation[]
  aiSummaries      AiSummary[]
  internalNotes    InternalNote[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, redmineBaseUrl, redmineIssueId])
  @@index([userId, statusId])
  @@index([userId, updatedOnRemote])
  @@index([parentIssueId])
}

model IssueAttachment {
  id                 String   @id @default(cuid())
  redmineAttachmentId Int
  issueId            String
  issue              Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename           String
  filesize           Int
  contentType        String?
  author             String?
  createdOnRemote    DateTime?
  downloadUrl        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([issueId, redmineAttachmentId])
  @@index([issueId, createdOnRemote])
}

model IssueRelation {
  id               String   @id @default(cuid())
  redmineRelationId Int
  issueId          String
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  targetIssueId    Int
  relationType     String
  delay            Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([issueId, redmineRelationId])
  @@index([issueId, relationType])
}

model AiSummary {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  summary   String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issueId])
  @@index([issueId])
}

model InternalNote {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([userId])
  @@index([issueId, createdAt(sort: Desc)])
}

model IssueGithubLink {
  id                String   @id @default(cuid())
  issueId           String
  issue             Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryFullName String
  githubIssueNumber Int?
  githubPrNumber    Int?
  url               String
  title             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([issueId, createdAt])
  @@index([userId, createdAt])
  @@unique([issueId, url])
}

model IssueJournal {
  id               String   @id @default(cuid())
  redmineJournalId Int
  issueId          String
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author           String?
  notes            String?
  createdOnRemote  DateTime
  createdAt        DateTime @default(now())

  @@unique([issueId, redmineJournalId])
  @@index([issueId, createdOnRemote])
}

model TimeEntry {
  id                 String    @id @default(cuid())
  redmineTimeEntryId Int?
  issueId            String
  issue              Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours              Float
  activityId         Int
  activityName       String?
  authorName         String?
  comments           String?
  spentOn            DateTime
  createdAt          DateTime  @default(now())

  @@unique([issueId, redmineTimeEntryId])
  @@index([userId, spentOn])
  @@index([issueId])
}

model SyncState {
  userId                String          @id
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastIncrementalSyncAt DateTime?
  lastFullSyncAt        DateTime?
  lastSyncStatus        String          @default("idle")
  lastError             String?
  runningJobId          String?
  updatedAt             DateTime        @updatedAt
}

model SyncJob {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobType    String
  status     String        @default("pending")
  startedAt  DateTime?
  endedAt    DateTime?
  error      String?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
}

model StatusCatalog {
  id        Int      @id
  name      String
  isClosed  Boolean
  updatedAt DateTime @updatedAt
}

model EnumerationCatalog {
  key        String   @id
  remoteId   Int
  kind       String
  name       String
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  position   Int?
  updatedAt  DateTime @updatedAt

  @@index([kind, remoteId])
  @@index([kind, isActive])
}

model LeaderLock {
  name       String   @id
  ownerId    String
  heartbeatAt DateTime
  expiresAt  DateTime
}

model MobileApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  tokenHash   String    @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, revokedAt])
}

model IssueEmbedding {
  id         String   @id @default(cuid())
  issueId    String   @unique
  embedding  String   // Stored as JSON string for SQLite compatibility
  model      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([issueId])
}
